# Production requires persistent PostgreSQL (postgres:// or postgresql://).
# Local development defaults to pglite:./data/pglite.
# Existing SQLite installs: follow docs/dependency-upgrade.md before starting.
DATABASE_URL=

# Public deployment origin used for sign-in, callbacks and absolute links.
APP_URL=

# Production: provide a stable random signing secret through deployment configuration.
# Never commit a real value; preserve the deployed secret across releases.
BETTER_AUTH_SECRET=
# Optional separate encryption key; otherwise Core uses the supported auth secret.
SECRETS_ENCRYPTION_KEY=

# Optional absolute directory on a persistent volume for the local upload provider.
# Leave unset locally to use data/uploads. Uploaded assets must survive deployments.
# FILE_UPLOADS_DIR=

# Configure model/provider credentials in Settings; editing works without an AI key.
